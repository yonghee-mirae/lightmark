{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "win-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "opener:allow-open-path",
    "opener:allow-open-url"
  ]
}
